# ==============================================================================
# AquaPulse Water Forecasting & Conservation Platform - Environment Variables
# Copy this file to '.env' and update values for your environment.
# ==============================================================================

# Application Metadata & Runtime Mode
PROJECT_NAME="AquaPulse Intelligent Water Consumption Platform"
VERSION="2.0.0"
ENVIRONMENT="production"     # "development" | "production"
LOG_LEVEL="INFO"             # "DEBUG" | "INFO" | "WARNING" | "ERROR"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# DB_ENGINE choices: "sqlite" | "mysql" | "postgresql"
DB_ENGINE="sqlite"

# Option A: Zero-setup local SQLite (Default out-of-the-box)
DATABASE_URL="sqlite:///./water_system.db"

# Option B: MySQL Database Connection (Production Standard)
# Set DB_ENGINE="mysql" to enable:
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="aquapulse_user"
MYSQL_PASSWORD="your_secure_mysql_password"
MYSQL_DATABASE="aquapulse_water_db"
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE=3600

# Or provide a full canonical connection string directly:
# DATABASE_URL="mysql+pymysql://aquapulse_user:your_secure_mysql_password@localhost:3306/aquapulse_water_db?charset=utf8mb4"

# ------------------------------------------------------------------------------
# Security, Authentication & CORS
# ------------------------------------------------------------------------------
# Change this secret key in production! Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace-with-a-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed origins (or leave blank to use secure defaults)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000,https://aquapulse-water-forecaster.onrender.com"

# ------------------------------------------------------------------------------
# Machine Learning & Economics
# ------------------------------------------------------------------------------
MODEL_DIR="./ml_pipeline/models"
WATER_RATE_PER_CUBIC_METER=3.65
