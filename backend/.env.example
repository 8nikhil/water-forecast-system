# =====================================================================
# AquaPulse Water Forecasting & Conservation Platform - Environment Variables
# =====================================================================

# Project Metadata
PROJECT_NAME="Intelligent Water Consumption Forecasting and Conservation System"
VERSION="2.0.0"

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# Engine choices: "sqlite" | "mysql" | "postgresql"
DB_ENGINE="sqlite"

# Option A: Zero-setup local SQLite (Default out-of-the-box)
DATABASE_URL="sqlite:///./water_system.db"

# Option B: MySQL Database Connection
# When DB_ENGINE=mysql, these parameters are automatically used with PyMySQL connection pooling:
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_secure_password"
MYSQL_DATABASE="aquapulse_water_db"
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE=3600

# Or provide a direct connection string:
# DATABASE_URL="mysql+pymysql://root:your_secure_password@localhost:3306/aquapulse_water_db?charset=utf8mb4"

# ---------------------------------------------------------------------
# Security & JWT Authentication
# ---------------------------------------------------------------------
SECRET_KEY="super-secret-water-forecasting-jwt-key-2026-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------
# Machine Learning & Economics
# ---------------------------------------------------------------------
MODEL_DIR="./backend/ml_models"
WATER_RATE_PER_CUBIC_METER=3.65
